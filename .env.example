# Copy to .env and fill in. Never commit .env.

# Discord webhook that receives "join" form submissions from the homepage
DISCORD_WEBHOOK=

# SQLite for local dev. For PostgreSQL see the comment at the top of prisma/schema.prisma.
DATABASE_URL="file:./prisma/dev.db"

# Password for /admin (also signs the admin session cookie)
ADMIN_PASSWORD=

# Real https domain. Must be set when running `npm run build` (canonical URLs, sitemap, robots.txt).
SITE_URL="http://localhost:3000"

# Optional: Google Search Console verification code
GOOGLE_SITE_VERIFICATION=
